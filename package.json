{
  "name": "stjosephs-patient-navigation",
  "private": true,
  "version": "0.1.0",
  "description": "Academic proof of concept (CEMS Team 3): multilingual QR + 3D wayfinding for St. Joseph's Hospital, London ON. Not a hospital-approved product.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "data:extract": "node scripts/extract-official-directions.mjs",
    "qr:sheet": "node scripts/print-checkpoint-urls.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
